.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "22"
guestOS = "darwin26-64"
displayName = "macOS Tahoe 26"
firmware = "efi"
bios.bootDelay = "5000"
bios.hddOrder = "sata0:0,sata0:1"

numvcpus = "2"
cpuid.coresPerSocket = "2"
memsize = "8192"

pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"

sata0.present = "TRUE"
sata0.pciSlotNumber = "37"
sata0:0.present = "TRUE"
sata0:0.fileName = "tahoe-recovery.vmdk"
sata0:0.deviceType = "disk"
sata0:1.present = "TRUE"
sata0:1.fileName = "tahoe-disk.vmdk"
sata0:1.deviceType = "disk"

ethernet0.present = "TRUE"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "e1000e"
ethernet0.addressType = "generated"
ethernet0.wakeOnPcktRcv = "FALSE"
ethernet0.pciSlotNumber = "33"

usb.present = "TRUE"
usb.pciSlotNumber = "32"
ehci.present = "TRUE"
ehci.pciSlotNumber = "35"
usb_xhci.present = "TRUE"
usb_xhci.pciSlotNumber = "36"

sound.present = "FALSE"

svga.autodetect = "TRUE"
svga.vramSize = "268435456"
svga.graphicsMemoryKB = "262144"
mks.enable3d = "FALSE"
svga.pciSlotNumber = "16"

smc.version = "0"
hpet0.present = "TRUE"

floppy0.present = "FALSE"
serial0.present = "FALSE"
parallel0.present = "FALSE"
vmci0.present = "FALSE"

pciBridge0.pciSlotNumber = "17"
pciBridge4.pciSlotNumber = "21"
pciBridge5.pciSlotNumber = "22"
pciBridge6.pciSlotNumber = "23"
pciBridge7.pciSlotNumber = "24"

powerType.powerOff = "soft"
powerType.powerOn = "soft"
powerType.suspend = "soft"
powerType.reset = "soft"

keyboardAndMouseProfile = "macOS"
tools.syncTime = "TRUE"
tools.upgrade.policy = "manual"
isolation.tools.hgfs.disable = "FALSE"
sharedFolder.maxNum = "0"
msg.autoAnswer = "TRUE"
